# Use com --dart-define ou --dart-define-from-file.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Emitente padrão da ordem de serviço (opcional). Preenche a tela "Dados do
# emitente da OS" enquanto nada foi salvo nela, e o botão "Usar meus dados
# padrão" traz estes valores de volta. Ficam aqui, e não no código, porque
# o repositório é público.
ORION_EMITENTE_EMPRESA=
ORION_EMITENTE_CNPJ=
ORION_EMITENTE_ENDERECO=
ORION_EMITENTE_CIDADE=
ORION_EMITENTE_RESPONSAVEL=
ORION_EMITENTE_FORMACAO=
ORION_EMITENTE_REGISTRO=
ORION_EMITENTE_TELEFONE=
ORION_EMITENTE_EMAIL=
